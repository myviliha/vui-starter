{
  "name": "@viliha/vui-ui",
  "version": "1.34.2",
  "description": "Vui UI is a free, token-driven React component library and admin dashboard template for Next.js and Tailwind CSS v4. It bundles the shadcn/ui set plus a full datatable, forms, charts, and auth screens, and ships as TypeScript source so your bundler compiles only what you import.",
  "license": "MIT",
  "author": "Suman Bonakurthi",
  "homepage": "https://vui.viliha.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myviliha/vui-starter.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/myviliha/vui-starter/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "nextjs",
    "next.js",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "shadcn",
    "shadcn-ui",
    "radix",
    "radix-ui",
    "typescript",
    "admin",
    "admin-template",
    "admin-dashboard",
    "dashboard",
    "dashboard-template",
    "react-admin",
    "crm",
    "saas",
    "saas-template",
    "datatable",
    "data-table",
    "ui",
    "ui-kit",
    "component-library",
    "components",
    "design-system",
    "dark-mode"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "bin",
    "template",
    "README.md",
    "AGENT.md",
    "CHANGELOG.md",
    "CLAUDE.template.md"
  ],
  "bin": {
    "vui-ui": "bin/vui.mjs",
    "vui": "bin/vui.mjs"
  },
  "exports": {
    "./theme.css": "./src/theme.css",
    "./utils": "./src/utils.ts",
    "./*": "./src/*.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsgo --noEmit",
    "test": "vitest run",
    "sync-template": "node scripts/sync-template.mjs",
    "release": "node scripts/publish.mjs",
    "prepublishOnly": "node scripts/guard-publish.mjs && node scripts/sync-template.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
