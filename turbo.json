{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BACKOFFICE_URL",
    "CI",
    "NEXT_PUBLIC_AUTH_BASE_URL",
    "NEXT_PUBLIC_DEFAULT_PAGE_SIZE",
    "NEXT_PUBLIC_KEEP_ALIVE_TABS",
    "NEXT_PUBLIC_MAX_CELL_CHARS",
    "NEXT_PUBLIC_MAX_PAGE_SIZE",
    "NEXT_PUBLIC_PASSWORD_MASK",
    "NEXT_PUBLIC_PRO_CHECKOUT_URL",
    "NEXT_PUBLIC_RESIZABLE_COLUMNS",
    "NEXT_PUBLIC_SHOW_DOCS",
    "NEXT_PUBLIC_SHOW_GLOBAL_SEARCH",
    "NEXT_PUBLIC_SHOW_HELP",
    "NEXT_PUBLIC_SHOW_NOTIFICATIONS",
    "NEXT_PUBLIC_SHOW_QUICK_ACTIONS",
    "NEXT_PUBLIC_SHOW_SETTINGS",
    "NEXT_PUBLIC_SHOW_USER_MENU",
    "NODE_ENV",
    "PORT",
    "WEBSITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    }
  }
}
