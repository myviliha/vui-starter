# Footer & brand identity — copy to .env.local and edit per deployment.
# All are optional; defaults are used when unset. NEXT_PUBLIC_ vars are read at
# build time and inlined into the exported site.

# App / brand identity — shown in the sidebar, wordmark, auth screens, and the
# browser-tab metadata. The tab title is "<APP_NAME> — <APP_TAGLINE>".
NEXT_PUBLIC_APP_NAME="Vui Starter"
NEXT_PUBLIC_APP_TAGLINE="React Admin & CRM Design System"
NEXT_PUBLIC_APP_DESCRIPTION="Your app description for search engines and social cards."
# Deploy origin (no trailing slash) — drives metadataBase, canonical + OG URLs.
# Set this to your domain in production.
NEXT_PUBLIC_APP_URL="https://vui.viliha.com"

# Runtime branding (multi-tenant / white-label). Point this at a JSON endpoint
# returning any of { name, tagline, description, logoUrl, faviconUrl, company,
# companyUrl }; BrandProvider fetches it on load and overrides the values above —
# including the tab title and favicon — live, no rebuild. (Or seed
# <BrandProvider initial={…}> from a loader, or call useBrand().setBrand(…) once
# your API responds.)
# NEXT_PUBLIC_BRAND_URL="https://api.example.com/branding"

NEXT_PUBLIC_COMPANY_NAME="VILIHA PTE. LTD."
# Optional — links the company name in the footer:
NEXT_PUBLIC_COMPANY_URL="https://viliha.com"
NEXT_PUBLIC_LICENSE="MIT Licensed"
# The copyright year is automatic (always the current/build year) — no env needed.

# Optional — your logo image, served from /public; falls back to the built-in
# mark. e.g. drop public/logo.svg and set:
# NEXT_PUBLIC_LOGO_URL="/logo.svg"

# Optional — browser-tab icon (favicon). Overrides the static app/icon.* files;
# falls back to them when unset. Serve from /public or use an absolute URL.
# NEXT_PUBLIC_FAVICON_URL="/favicon.png"

# Override the entire footer line at once (takes precedence over the vars above):
# NEXT_PUBLIC_FOOTER_NOTICE="© 2026 Acme Inc. · All rights reserved"

# Max pages kept open in the tab strip (client-side). Default 5, min 1. Opening
# more evicts the oldest tab with a warning.
NEXT_PUBLIC_MAX_TABS="5"

# Max characters a data-table cell shows before truncating to one line with an
# ellipsis (…) + hover tooltip. Long text never wraps. Default 25. Override per
# table with the RecordView `maxCellChars` prop, or per column with a field's
# `maxChars` (0 = never truncate that column).
NEXT_PUBLIC_MAX_CELL_CHARS="25"

# How a collapsed sidebar rail reveals a group's sub-items. One of:
#   inline        — expands underneath the icon, in the rail itself
#   flyout-click  — click the icon to open a floating panel beside the rail
#   flyout-hover  — hover the icon to open it (click still works too)
# Default: flyout-hover
NEXT_PUBLIC_SIDEBAR_GROUP_MODE="flyout-hover"
